# LLM Wiki — Environment Variables
# Copy to .env and fill in your API keys.

# LLM provider selection: set to "deepseek" or "minimax" to use only that
# cloud provider + ollama fallback. Leave empty to try all configured providers.
# WIKI_LLM_PROVIDER=deepseek

# MiniMax
# WIKI_MINIMAX_API_KEY=xxx
# WIKI_MINIMAX_API_BASE=https://api.minimaxi.com/v1

# DeepSeek V4 Flash (cheap, high quality, 1M context)
# WIKI_DEEPSEEK_API_KEY=sk-...

# Groq (free tier: 14,400 req/day)
# WIKI_GROQ_API_KEY=gsk_...

# Google Gemini (free tier: 1,500 req/day)
# WIKI_GEMINI_API_KEY=AI...

# Ollama (local, no key needed)
# WIKI_OLLAMA_HOST=http://127.0.0.1:11434
# WIKI_OLLAMA_MODEL=ollama/qwen3:4b

# Wiki settings
# WIKI_WIKI_DIR=wiki
# WIKI_SOURCES_DIR=sources
# WIKI_LOG_LEVEL=INFO

# Concurrency
# WIKI_MAX_CONCURRENT_LLM=3
